# CredValid frontend configuration. Copy to .env.local and fill in.
# Everything here is public: it ships inside the JavaScript bundle.
# NEVER put private keys, mnemonics or API secrets in this file.

# Leave VITE_CONTRACT_ADDRESS empty to run in demo mode only.
# Testnet mode switches on once a real CredValidRegistry address is set.
VITE_CHAIN_ID=80002
VITE_CONTRACT_ADDRESS=

# Block the contract was deployed in. Event scans (credential and issuer lists) start here.
# Printed by the deploy script as "Deployment block".
VITE_DEPLOY_BLOCK=

# Optional. Defaults to Polygon Amoy's public RPC and Polygonscan explorer.
# Public RPCs rate-limit; a provider endpoint (Alchemy, Infura, QuickNode) is more reliable.
VITE_RPC_URL=
VITE_EXPLORER_URL=https://amoy.polygonscan.com

# Optional. Base URL encoded in QR codes, e.g. https://verify.example.edu
# Defaults to the origin the app is served from.
VITE_PUBLIC_APP_URL=

# Optional. "hash" uses #/ routes for static hosts without SPA rewrites.
VITE_ROUTER=
