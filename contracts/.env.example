# Foundry deployment settings. Copy to .env (git-ignored) and fill in.
# Do NOT put a private key here. Import it into Foundry's encrypted keystore instead:
#   cast wallet import credvalid-deployer --interactive

AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=

# Optional: who receives DEFAULT_ADMIN_ROLE + ISSUER_ADMIN_ROLE (defaults to the deployer)
CREDVALID_ADMIN=

# Optional: register a first issuer during deployment
CREDVALID_FIRST_ISSUER=
CREDVALID_FIRST_SIGNER=
CREDVALID_FIRST_ISSUER_NAME=
